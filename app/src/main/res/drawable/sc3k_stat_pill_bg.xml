<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer inset shadow line -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#040810" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <!-- Inset border highlight -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A2B48" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Stat pill background surface -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0F1B33"
                android:centerColor="#0B1326"
                android:endColor="#060B18" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Top cyan accent micro-bar -->
    <item
        android:left="3dp"
        android:top="2dp"
        android:right="3dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#00D9FF" />
            <size android:height="1dp" />
        </shape>
    </item>
</layer-list>
