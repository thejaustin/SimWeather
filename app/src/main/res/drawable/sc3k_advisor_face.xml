<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Head Shape -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFCC99" /> <!-- Skin -->
            <corners android:radius="2dp" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
    
    <!-- Hair -->
    <item android:bottom="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#4E342E" /> <!-- Brown Hair -->
            <corners android:topLeftRadius="2dp" android:topRightRadius="2dp" />
        </shape>
    </item>

    <!-- Eyes (Left) -->
    <item android:left="8dp" android:top="16dp" android:right="26dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Eyes (Right) -->
    <item android:left="26dp" android:top="16dp" android:right="8dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Glasses (Bridge) -->
    <item android:left="14dp" android:top="18dp" android:right="14dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    
    <!-- Mouth -->
    <item android:left="12dp" android:top="30dp" android:right="12dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    
    <!-- Collar/Suit -->
    <item android:top="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A2540" /> <!-- Blue Suit -->
            <corners android:bottomLeftRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
