<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- SimCity Weather Theme -->
    <style name="Theme.SimWeather" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sim_teal_primary</item>
        <item name="colorPrimaryVariant">@color/sim_teal_dark</item>
        <item name="colorOnPrimary">@color/sim_dark_bg</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/sim_cyan_bright</item>
        <item name="colorSecondaryVariant">@color/sim_teal_dark</item>
        <item name="colorOnSecondary">@color/sim_dark_bg</item>
        <!-- Background colors. -->
        <item name="android:colorBackground">@color/sim_dark_bg</item>
        <item name="colorSurface">@color/sim_dark_surface</item>
        <item name="colorOnSurface">@color/sim_text_primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/sim_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation bar color. -->
        <item name="android:navigationBarColor">@color/sim_dark_bg</item>
    </style>
</resources>
