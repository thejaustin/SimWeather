<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Advisor Tabs Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAdvFin"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/sc3k_button_bg"
            android:fontFamily="monospace"
            android:padding="0dp"
            android:text="FIN"
            android:textColor="@color/sim_cyan_bright"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAdvEnv"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/sc3k_button_bg"
            android:fontFamily="monospace"
            android:padding="0dp"
            android:text="ENV"
            android:textColor="@color/sim_text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnAdvSafe"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/sc3k_button_bg"
            android:fontFamily="monospace"
            android:padding="0dp"
            android:text="SAF"
            android:textColor="@color/sim_text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnAdvTra"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/sc3k_button_bg"
            android:fontFamily="monospace"
            android:padding="0dp"
            android:text="TRA"
            android:textColor="@color/sim_text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnAdvHlth"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/sc3k_button_bg"
            android:fontFamily="monospace"
            android:padding="0dp"
            android:text="HLT"
            android:textColor="@color/sim_text_primary"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sc3k_button_bg"
            android:padding="4dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/sc3k_advisor_face" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdvisorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Mortimer Green (Financial)"
                android:textColor="@color/sim_cyan_bright"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClothingAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="@string/clothing_advice_placeholder"
                android:textColor="@color/sim_text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- RCI Demand View -->
        <com.thejaustin.simweather.ui.view.RciDemandView
            android:id="@+id/rciDemandGauge"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
