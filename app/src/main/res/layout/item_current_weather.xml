<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/currentWeatherCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/sc3k_concrete_texture"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Weather Condition Icon Badge -->
        <TextView
            android:id="@+id/tvConditionIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:text="☀️"
            android:textColor="@color/sim_yellow"
            android:textSize="54sp" />

        <!-- Temperature Display -->
        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/current_weather_temp_placeholder"
            android:textColor="@color/sim_yellow"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="@string/current_weather_loading_placeholder"
            android:textColor="@color/sim_text_primary"
            android:textSize="18sp" />

        <!-- SimCity Analytics Banner -->
        <LinearLayout
            android:id="@+id/analyticsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/sc3k_stat_pill_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvMayorApproval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="😊 MAYOR APPROVAL: 88% (BELOVED)"
                android:textColor="@color/sim_yellow"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAnalyticsRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="CIVIC COMFORT INDEX: 85% (OPTIMAL)"
                android:textColor="@color/sim_cyan_bright"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEnergyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="POWER DEMAND: LOW HVAC"
                android:textColor="@color/sim_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPressureTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="BAROMETER: STEADY PRESSURE"
                android:textColor="@color/sim_green"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDewPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="HUMIDITY COMFORT: COMFORTABLE"
                android:textColor="@color/sim_teal_primary"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Weather Stats Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Left Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/statFeelsLike"
                    layout="@layout/item_weather_stat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/statWind"
                    layout="@layout/item_weather_stat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    android:id="@+id/statPressure"
                    layout="@layout/item_weather_stat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Right Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/statHumidity"
                    layout="@layout/item_weather_stat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/statVisibility"
                    layout="@layout/item_weather_stat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    android:id="@+id/statUV"
                    layout="@layout/item_weather_stat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/item_air_quality" />

    </LinearLayout>

</LinearLayout>
