<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sc3k_concrete_bg_tiled"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sc3k_header_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="⚙ SETTINGS"
            android:textColor="@color/sim_cyan_bright"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Configure SimWeather"
            android:textColor="@color/sim_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Settings Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Units Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="MEASUREMENT UNITS"
            android:textColor="@color/sim_teal_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@color/sc3k_border_highlight" />

        <!-- Radio Buttons for Units -->
        <RadioGroup
            android:id="@+id/rgUnits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbMetric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/sc3k_brick_bg_tiled"
                android:buttonTint="@color/sim_cyan_bright"
                android:checked="true"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="METRIC (°C, km/h, mm)"
                android:textColor="@color/sim_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbImperial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sc3k_brick_bg_tiled"
                android:buttonTint="@color/sim_cyan_bright"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="IMPERIAL (°F, mph, in)"
                android:textColor="@color/sim_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RadioGroup>

        <!-- Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/sc3k_brick_bg_tiled"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="ℹ"
                android:textColor="@color/sim_cyan_bright"
                android:textSize="24sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="Weather will refresh automatically when units are changed"
                android:textColor="@color/sim_text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/sc3k_button_bg"
            android:fontFamily="monospace"
            android:text="CANCEL"
            android:textColor="@color/sim_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/sc3k_button_bg"
            android:fontFamily="monospace"
            android:text="APPLY"
            android:textColor="@color/sim_cyan_bright"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
